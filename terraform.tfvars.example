# The name of the project, used for tagging resources
project_name = "coder-co"

# The AWS region where resources will be deployed
region = "us-east-1"

# The availability zone to use for resources (e.g., us-east-1a, us-east-1b)
availability_zone = "us-east-1a"

# The VPC CIDR block
vpc_cidr_block = "10.0.0.0/16"

# The subnet CIDR block within the VPC
subnet_cidr_block = "10.0.1.0/24"

# The CIDR block allowed to SSH into the instance
# WARNING: Setting this to 0.0.0.0/0 allows access from anywhere.
allow_ssh_cidr = "0.0.0.0/0"

# The instance type for the EC2 instance
instance_type = "t3.micro"

# The Amazon Machine Image (AMI) ID for the EC2 instance
ami = "ami-068c0051b15cdb816"

# The name of the SSH key pair to associate with the instance
key_name = "deployer_key"
